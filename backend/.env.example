# AgentScore backend. Copy to backend/.env and fill. NEVER commit .env.
# All keys are Arc Testnet only, funded from the Circle faucet — zero real value.

# Reads (Arc Testnet). dRPC handles load without 429s.
ARC_RPC=https://arc-testnet.drpc.org

# Our deployed data-only registry (public address).
REGISTRY_ADDRESS=0x1489b56AaE4BB63e9793a151C12964B19bC99d38

# HTTP port for the API.
PORT=8787

# Set to 1 to run the read-only API without the signing worker (serverless mode).
API_ONLY=

# Worker signing keys (testnet only). Required unless API_ONLY=1. Never commit.
ARBITER_PRIVATE_KEY=
AGENT_LEXICA_PRIVATE_KEY=
