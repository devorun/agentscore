# AgentScore backend. Copy to backend/.env and fill. NEVER commit .env.
# All keys are Arc Testnet only, funded from the Circle faucet — zero real value.

# Reads (Arc Testnet). dRPC handles load without 429s.
ARC_RPC=https://arc-testnet.drpc.org

# Our deployed data-only registry (public address).
REGISTRY_ADDRESS=0x1489b56AaE4BB63e9793a151C12964B19bC99d38

# HTTP port for the API.
PORT=8787

# Set to 1 to run the read-only API without the signing worker (serverless mode).
API_ONLY=

# Worker signing keys (testnet only). Required unless API_ONLY=1. Never commit.
ARBITER_PRIVATE_KEY=
AGENT_LEXICA_PRIVATE_KEY=

# Demo price the agent sets (USDC). Defaults to 10.
AGENT_PRICE_USDC=

# Separate demo client wallet (for scripts/demo.ts). Testnet only, never commit.
DEMO_CLIENT_ADDRESS=
DEMO_CLIENT_PRIVATE_KEY=

# LLM for judged-quality jobs (agent memo + arbiter evaluation). Leave BLANK for
# the $0 default: deterministic jobs always work; [JUDGED] jobs are simply
# skipped (never fabricated). Only set with a FREE-TIER key (Groq — no card).
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
# Different model FAMILIES on purpose (no self-grading): the agent writes, an
# independent family judges. Defaults in code: llama-3.3-70b-versatile (agent)
# and openai/gpt-oss-120b (arbiter). Override only with free-tier models.
AGENT_LLM_MODEL=
ARBITER_LLM_MODEL=

# --- Circle developer tools (optional; Arc Testnet only, $0, no card) ---------
# Nanopayments per-row rail. Blank/0 = default escrow-only loop (unchanged);
# 1 = also meter per-row micro-USDC via Circle Gateway. Permissionless, no key.
NANOPAY_ENABLED=

# Agent signer. Blank/"raw" (default) = sign with AGENT_LEXICA_PRIVATE_KEY;
# "circle" = route the agent's Arc txs through a developer-controlled Circle Wallet.
SIGNER_MODE=

# Circle Developer Console (Sandbox/Testnet) — free, no card. Fill only for
# SIGNER_MODE=circle. Create at https://console.circle.com/signup.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_AGENT_WALLET_ID=
